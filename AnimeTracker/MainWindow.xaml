                                                       TextWrapping="Wrap">
                                                <Run Text="{DynamicResource About_GitHub}"/>: 
                                                <Hyperlink NavigateUri="https://github.com/ThePhantomRU" 
                                                           RequestNavigate="Hyperlink_RequestNavigate" 
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="{DynamicResource About_GitHubLink}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>