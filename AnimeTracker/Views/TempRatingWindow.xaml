<Window x:Class="AnimeTracker.Views.TempRatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AnimeTracker.Views"
        Title="{DynamicResource TempRating_Title}" Height="750" Width="950"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <!-- Стиль для вкладок (использует глобальные ресурсы) -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PanelBackground}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource TempRating_Title}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="❓" Width="30" Height="30" Style="{DynamicResource WindowButtonStyle}" 
                            Click="ShowCriteriaHelp_Click" ToolTip="{DynamicResource Button_CriteriaHelp}"/>
                    <Button Content="✕" Style="{DynamicResource WindowButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <StackPanel Margin="20">
                    <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource TempRating_Info}" TextWrapping="Wrap" 
                                   Foreground="{DynamicResource AccentLightBrush}" FontSize="14" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding AnimeTitle}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                        <TabControl x:Name="PartsTabControl" Background="Transparent" BorderBrush="Transparent"/>
                    </Border>
                    <Button Content="{DynamicResource Button_Save}" Margin="0,20,0,0" Height="40" Click="SaveButton_Click" IsDefault="True"/>
                    <Button Content="{DynamicResource Button_Cancel}" Margin="0,10,0,0" Height="40" Click="CancelButton_Click" IsCancel="True" Background="#D32F2F"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>