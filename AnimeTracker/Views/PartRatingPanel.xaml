<UserControl x:Class="AnimeTracker.Views.PartRatingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="5">
            <TextBlock Text="Основные критерии" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <UniformGrid Columns="2">
                <!-- Story -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Story}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Story, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Story, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Main Characters -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_MainCharacters}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding MainCharacters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding MainCharacters, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Characters -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Characters}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Characters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Characters, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Visual -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Visual}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Visual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Visual, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Sound -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Sound}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Sound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Sound, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Emotions -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Emotions}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Emotions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Emotions, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Originality -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Originality}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Originality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Originality, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Finale -->
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Criteria_Finale}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Finale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                    <TextBlock Text="{Binding Finale, StringFormat={}{0:F0}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <!-- Опенинги -->
            <TextBlock Text="{DynamicResource Part_Openings}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
            <StackPanel x:Name="OpeningsPanel"/>

            <!-- Эндинги -->
            <TextBlock Text="{DynamicResource Part_Endings}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
            <StackPanel x:Name="EndingsPanel"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>