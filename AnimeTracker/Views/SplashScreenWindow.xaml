<Window x:Class="AnimeTracker.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка" Height="450" Width="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="LogoAnimation">
            <!-- Основная звезда: полёт по эллипсу + спуск (3.5 сек) -->
            <MatrixAnimationUsingPath
                Storyboard.TargetName="StarMainMatrix"
                Storyboard.TargetProperty="Matrix"
                Duration="0:0:3.5"
                DoesRotateWithTangent="True">
                <MatrixAnimationUsingPath.PathGeometry>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <BezierSegment Point1="110,-110" Point2="150,-50" Point3="150,50"/>
                                    <BezierSegment Point1="150,110" Point2="110,150" Point3="0,150"/>
                                    <BezierSegment Point1="-110,150" Point2="-150,110" Point3="-150,50"/>
                                    <BezierSegment Point1="-150,-50" Point2="-110,-110" Point3="0,-110"/>
                                </PathFigure.Segments>
                            </PathFigure>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <LineSegment Point="0,0"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </MatrixAnimationUsingPath.PathGeometry>
            </MatrixAnimationUsingPath>

            <!-- Эхо 1 (задержка 0.15 с) -->
            <MatrixAnimationUsingPath
                Storyboard.TargetName="Echo1Matrix"
                Storyboard.TargetProperty="Matrix"
                BeginTime="0:0:0.15"
                Duration="0:0:3.5"
                DoesRotateWithTangent="True">
                <MatrixAnimationUsingPath.PathGeometry>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <BezierSegment Point1="110,-110" Point2="150,-50" Point3="150,50"/>
                                    <BezierSegment Point1="150,110" Point2="110,150" Point3="0,150"/>
                                    <BezierSegment Point1="-110,150" Point2="-150,110" Point3="-150,50"/>
                                    <BezierSegment Point1="-150,-50" Point2="-110,-110" Point3="0,-110"/>
                                </PathFigure.Segments>
                            </PathFigure>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <LineSegment Point="0,0"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </MatrixAnimationUsingPath.PathGeometry>
            </MatrixAnimationUsingPath>
            <DoubleAnimation Storyboard.TargetName="Echo1" Storyboard.TargetProperty="Opacity" From="0.4" To="0" BeginTime="0:0:1.5" Duration="0:0:2"/>

            <!-- Эхо 2 (задержка 0.3 с) -->
            <MatrixAnimationUsingPath
                Storyboard.TargetName="Echo2Matrix"
                Storyboard.TargetProperty="Matrix"
                BeginTime="0:0:0.3"
                Duration="0:0:3.5"
                DoesRotateWithTangent="True">
                <MatrixAnimationUsingPath.PathGeometry>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <BezierSegment Point1="110,-110" Point2="150,-50" Point3="150,50"/>
                                    <BezierSegment Point1="150,110" Point2="110,150" Point3="0,150"/>
                                    <BezierSegment Point1="-110,150" Point2="-150,110" Point3="-150,50"/>
                                    <BezierSegment Point1="-150,-50" Point2="-110,-110" Point3="0,-110"/>
                                </PathFigure.Segments>
                            </PathFigure>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <LineSegment Point="0,0"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </MatrixAnimationUsingPath.PathGeometry>
            </MatrixAnimationUsingPath>
            <DoubleAnimation Storyboard.TargetName="Echo2" Storyboard.TargetProperty="Opacity" From="0.3" To="0" BeginTime="0:0:1.5" Duration="0:0:2"/>

            <!-- Эхо 3 (задержка 0.45 с) -->
            <MatrixAnimationUsingPath
                Storyboard.TargetName="Echo3Matrix"
                Storyboard.TargetProperty="Matrix"
                BeginTime="0:0:0.45"
                Duration="0:0:3.5"
                DoesRotateWithTangent="True">
                <MatrixAnimationUsingPath.PathGeometry>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <BezierSegment Point1="110,-110" Point2="150,-50" Point3="150,50"/>
                                    <BezierSegment Point1="150,110" Point2="110,150" Point3="0,150"/>
                                    <BezierSegment Point1="-110,150" Point2="-150,110" Point3="-150,50"/>
                                    <BezierSegment Point1="-150,-50" Point2="-110,-110" Point3="0,-110"/>
                                </PathFigure.Segments>
                            </PathFigure>
                            <PathFigure StartPoint="0,-110">
                                <PathFigure.Segments>
                                    <LineSegment Point="0,0"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </MatrixAnimationUsingPath.PathGeometry>
            </MatrixAnimationUsingPath>
            <DoubleAnimation Storyboard.TargetName="Echo3" Storyboard.TargetProperty="Opacity" From="0.2" To="0" BeginTime="0:0:1.5" Duration="0:0:2"/>

            <!-- Появление надписей (3.5 сек) -->
            <DoubleAnimation Storyboard.TargetName="TitleText" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:3.5"/>
            <DoubleAnimation Storyboard.TargetName="SubtitleText" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:3.5"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border Background="#0A0A12" CornerRadius="20" Opacity="0.95"/>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Height="350">

            <!-- Основная звезда -->
            <Grid x:Name="StarMainContainer" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="StarMainMatrix"/>
                </Grid.RenderTransform>
                <TextBlock x:Name="StarMain" Text="✦" FontSize="52" Foreground="#FFB3A8FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Эхо-звёзды -->
            <Grid x:Name="Echo1Container" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="Echo1Matrix"/>
                </Grid.RenderTransform>
                <TextBlock x:Name="Echo1" Text="✦" FontSize="42" Foreground="#FFB3A8FF" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
            </Grid>
            <Grid x:Name="Echo2Container" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="Echo2Matrix"/>
                </Grid.RenderTransform>
                <TextBlock x:Name="Echo2" Text="✦" FontSize="34" Foreground="#FFB3A8FF" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
            </Grid>
            <Grid x:Name="Echo3Container" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="Echo3Matrix"/>
                </Grid.RenderTransform>
                <TextBlock x:Name="Echo3" Text="✦" FontSize="26" Foreground="#FFB3A8FF" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>
            </Grid>

            <!-- Надписи -->
            <TextBlock x:Name="TitleText" Text="ANIME TRACKER" FontSize="28" FontWeight="Bold"
                       Foreground="White" Opacity="0" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="0,100,0,0"/>
            <TextBlock x:Name="SubtitleText" Text="{DynamicResource Instr_Subtitle}" FontSize="15"
                       Foreground="#FF8C8C9E" Opacity="0" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="0,145,0,0"/>
        </Grid>
    </Grid>
</Window>