    <!-- Descriptions for "Story" -->
    <sys:String x:Key="Criteria_Story_1">No coherent story, random scenes without logic.</sys:String>
    <sys:String x:Key="Criteria_Story_2">Very weak plot, full of clichés, no suspense.</sys:String>
    <sys:String x:Key="Criteria_Story_3">Mediocre story, has an idea but boring and predictable execution.</sys:String>
    <sys:String x:Key="Criteria_Story_4">Decent plot, but too straightforward, lacks surprises.</sys:String>
    <sys:String x:Key="Criteria_Story_5">Engaging story, holds attention, has interesting moments.</sys:String>
    <sys:String x:Key="Criteria_Story_6">Well-constructed narrative with logical twists and development.</sys:String>
    <sys:String x:Key="Criteria_Story_7">Captivating plot with unexpected turns, hard to put down.</sys:String>
    <sys:String x:Key="Criteria_Story_8">Excellent story, meticulously thought out, intriguing till the end.</sys:String>
    <sys:String x:Key="Criteria_Story_9">Brilliant, genre‑redefining, leaves a lasting impression.</sys:String>
    <sys:String x:Key="Criteria_Story_10">Masterpiece of storytelling, flawless structure, complete immersion.</sys:String>

    <!-- Descriptions for "Main characters" -->
    <sys:String x:Key="Criteria_MainCharacters_1">Main characters are flat, lack personality, irritating.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_2">Stereotypical characters, unclear motivation.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_3">Average characters, not memorable, but not annoying.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_4">Some traits, but poorly developed.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_5">Likeable characters, you sympathize, but they lack depth.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_6">Vivid, with clear motivation, interesting to follow.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_7">Charismatic, dynamically evolve, actions are logical.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_8">Very lively, with inner conflicts, evoke strong emotions.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_9">Brilliantly crafted, become iconic.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_10">Ideal heroes, embody the best human qualities.</sys:String>

    <!-- Descriptions for "Supporting characters" -->
    <sys:String x:Key="Criteria_Characters_1">All supporting characters are faceless masses.</sys:String>
    <sys:String x:Key="Criteria_Characters_2">Stereotypical, only there for background.</sys:String>
    <sys:String x:Key="Criteria_Characters_3">A few interesting ones, but the rest are forgettable.</sys:String>
    <sys:String x:Key="Criteria_Characters_4">Some have personality, but weakly developed.</sys:String>
    <sys:String x:Key="Criteria_Characters_5">Usually complement the world, sometimes amusing or touching.</sys:String>
    <sys:String x:Key="Criteria_Characters_6">Memorable, each has a role and background.</sys:String>
    <sys:String x:Key="Criteria_Characters_7">Well written, make the world feel full and alive.</sys:String>
    <sys:String x:Key="Criteria_Characters_8">Distinctive, with strong personalities, likable.</sys:String>
    <sys:String x:Key="Criteria_Characters_9">Genius writing, each leaves a mark.</sys:String>
    <sys:String x:Key="Criteria_Characters_10">Brilliant, perfectly complement the story, unforgettable.</sys:String>

    <!-- Descriptions for "Art & Animation" -->
    <sys:String x:Key="Criteria_Visual_1">Terrible art, characters and backgrounds repel.</sys:String>
    <sys:String x:Key="Criteria_Visual_2">Poor animation, many errors, sloppy.</sys:String>
    <sys:String x:Key="Criteria_Visual_3">Average quality, but noticeable flaws.</sys:String>
    <sys:String x:Key="Criteria_Visual_4">Pleasant style, but animation doesn't impress.</sys:String>
    <sys:String x:Key="Criteria_Visual_5">Good art, neat drawing, but no zest.</sys:String>
    <sys:String x:Key="Criteria_Visual_6">Beautiful, detailed, smooth motion.</sys:String>
    <sys:String x:Key="Criteria_Visual_7">High quality, unique style, animation feels alive.</sys:String>
    <sys:String x:Key="Criteria_Visual_8">Excellent work: backgrounds, design, dynamics all top.</sys:String>
    <sys:String x:Key="Criteria_Visual_9">Stunning visuals, almost cinematic quality.</sys:String>
    <sys:String x:Key="Criteria_Visual_10">Masterpiece of animation, every frame is a work of art.</sys:String>

    <!-- Descriptions for "Sound & Music" -->
    <sys:String x:Key="Criteria_Sound_1">Sound is annoying, music doesn't fit.</sys:String>
    <sys:String x:Key="Criteria_Sound_2">Poor quality, unnatural sounds break immersion.</sys:String>
    <sys:String x:Key="Criteria_Sound_3">Average soundtrack, nothing memorable.</sys:String>
    <sys:String x:Key="Criteria_Sound_4">Decent music, but sometimes mismatched with scenes.</sys:String>
    <sys:String x:Key="Criteria_Sound_5">Good soundtrack, enhances mood, but not outstanding.</sys:String>
    <sys:String x:Key="Criteria_Sound_6">Pleasant music and quality sound effects, immerse you.</sys:String>
    <sys:String x:Key="Criteria_Sound_7">Great soundtrack, memorable themes, perfectly timed.</sys:String>
    <sys:String x:Key="Criteria_Sound_8">Brilliant soundtrack, sound perfectly complements visuals.</sys:String>
    <sys:String x:Key="Criteria_Sound_9">Music lives on its own, adds depth, you want to listen again.</sys:String>
    <sys:String x:Key="Criteria_Sound_10">Flawless sound, half the emotions come from music and effects.</sys:String>

    <!-- Descriptions for "Opening Theme" -->
    <sys:String x:Key="Criteria_Opening_1">Boring, emotionless, you want to skip.</sys:String>
    <sys:String x:Key="Criteria_Opening_2">Weak OP, neither music nor visuals grab you.</sys:String>
    <sys:String x:Key="Criteria_Opening_3">Average opening, not bad but not good.</sys:String>
    <sys:String x:Key="Criteria_Opening_4">Some interesting elements, but overall forgettable.</sys:String>
    <sys:String x:Key="Criteria_Opening_5">Good music and visuals, lifts your mood.</sys:String>
    <sys:String x:Key="Criteria_Opening_6">Beautiful, dynamic, you want to rewatch.</sys:String>
    <sys:String x:Key="Criteria_Opening_7">Memorable, stylish, reflects the anime's essence.</sys:String>
    <sys:String x:Key="Criteria_Opening_8">Excellent, energizes, you would listen separately.</sys:String>
    <sys:String x:Key="Criteria_Opening_9">Magnificent, one of the best I've seen.</sys:String>
    <sys:String x:Key="Criteria_Opening_10">Perfect opening – a masterpiece of music and animation.</sys:String>

    <!-- Descriptions for "Ending Theme" -->
    <sys:String x:Key="Criteria_Ending_1">Boring, emotionless, you want to skip.</sys:String>
    <sys:String x:Key="Criteria_Ending_2">Weak ED, neither music nor visuals grab you.</sys:String>
    <sys:String x:Key="Criteria_Ending_3">Average ending, not bad but not good.</sys:String>
    <sys:String x:Key="Criteria_Ending_4">Some interesting elements, but overall forgettable.</sys:String>
    <sys:String x:Key="Criteria_Ending_5">Good music and visuals, lifts your mood.</sys:String>
    <sys:String x:Key="Criteria_Ending_6">Beautiful, dynamic, you want to rewatch.</sys:String>
    <sys:String x:Key="Criteria_Ending_7">Memorable, stylish, reflects the anime's essence.</sys:String>
    <sys:String x:Key="Criteria_Ending_8">Excellent, energizes, you would listen separately.</sys:String>
    <sys:String x:Key="Criteria_Ending_9">Magnificent, one of the best I've seen.</sys:String>
    <sys:String x:Key="Criteria_Ending_10">Perfect ending – a masterpiece of music and animation.</sys:String>

    <!-- Descriptions for "Emotional Impact" -->
    <sys:String x:Key="Criteria_Emotions_1">Evokes no emotions, dry and indifferent.</sys:String>
    <sys:String x:Key="Criteria_Emotions_2">Almost doesn't touch you, feelings pass by.</sys:String>
    <sys:String x:Key="Criteria_Emotions_3">Rare glimpses of emotion, mostly indifferent.</sys:String>
    <sys:String x:Key="Criteria_Emotions_4">Some scenes affect you, but overall weak.</sys:String>
    <sys:String x:Key="Criteria_Emotions_5">Average emotionality, you sympathize, but no strong shakes.</sys:String>
    <sys:String x:Key="Criteria_Emotions_6">Draws you into experiences, evokes genuine feelings.</sys:String>
    <sys:String x:Key="Criteria_Emotions_7">Captivates, makes you happy, sad, worried.</sys:String>
    <sys:String x:Key="Criteria_Emotions_8">Very strong impression, scenes stay with you.</sys:String>
    <sys:String x:Key="Criteria_Emotions_9">Strikes deep, brings tears or laughter.</sys:String>
    <sys:String x:Key="Criteria_Emotions_10">Incredible emotional power, turns your soul.</sys:String>

    <!-- Descriptions for "Originality" -->
    <sys:String x:Key="Criteria_Originality_1">Complete copy of other anime, nothing new.</sys:String>
    <sys:String x:Key="Criteria_Originality_2">Almost everything borrowed, novelty near zero.</sys:String>
    <sys:String x:Key="Criteria_Originality_3">A few fresh ideas, but mostly formulaic.</sys:String>
    <sys:String x:Key="Criteria_Originality_4">Unusual moments, but the base is cliché.</sys:String>
    <sys:String x:Key="Criteria_Originality_5">Typical genre approach, but with small finds.</sys:String>
    <sys:String x:Key="Criteria_Originality_6">Noticeably different from the average, has its own style.</sys:String>
    <sys:String x:Key="Criteria_Originality_7">Original, intriguing, unexpected solutions.</sys:String>
    <sys:String x:Key="Criteria_Originality_8">Unique world, fresh perspective, rethinks the genre.</sys:String>
    <sys:String x:Key="Criteria_Originality_9">Rare originality, concept surprises and inspires.</sys:String>
    <sys:String x:Key="Criteria_Originality_10">Genius, nothing like it has ever existed.</sys:String>

    <!-- Descriptions for "Finale" -->
    <sys:String x:Key="Criteria_Finale_1">Terrible ending, ruined everything.</sys:String>
    <sys:String x:Key="Criteria_Finale_2">Very weak, blunted the whole impression.</sys:String>
    <sys:String x:Key="Criteria_Finale_3">Mediocre finale, doesn't match the development.</sys:String>
    <sys:String x:Key="Criteria_Finale_4">Decent, but too predictable and flat.</sys:String>
    <sys:String x:Key="Criteria_Finale_5">Average ending, no delight, but no disappointment.</sys:String>
    <sys:String x:Key="Criteria_Finale_6">Good conclusion, all storylines resolved.</sys:String>
    <sys:String x:Key="Criteria_Finale_7">Great ending, leaves a pleasant aftertaste.</sys:String>
    <sys:String x:Key="Criteria_Finale_8">Strong finale, memorable and satisfying.</sys:String>
    <sys:String x:Key="Criteria_Finale_9">Magnificent, hard to forget, evokes admiration.</sys:String>
    <sys:String x:Key="Criteria_Finale_10">Perfect finale — everything is masterfully concluded, leaving a deep sense of satisfaction.</sys:String>

