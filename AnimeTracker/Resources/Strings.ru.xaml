    <sys:String x:Key="Criteria_Finale">Финал (концовка)</sys:String>

    <!-- Описания для критерия "Сюжет" -->
    <sys:String x:Key="Criteria_Story_1">Сюжет отсутствует, бессвязный набор сцен, логика нарушена.</sys:String>
    <sys:String x:Key="Criteria_Story_2">Очень слабая история, полная штампов, без интриги.</sys:String>
    <sys:String x:Key="Criteria_Story_3">Посредственный сюжет, есть идея, но реализация скучная и предсказуемая.</sys:String>
    <sys:String x:Key="Criteria_Story_4">Неплохой сюжет, но слишком прямолинейный, без неожиданных поворотов.</sys:String>
    <sys:String x:Key="Criteria_Story_5">Увлекательный сюжет, держит внимание, есть интересные моменты.</sys:String>
    <sys:String x:Key="Criteria_Story_6">Хорошо построенная история с логичными поворотами и развитием.</sys:String>
    <sys:String x:Key="Criteria_Story_7">Захватывающий сюжет с неожиданными ходами, трудно оторваться.</sys:String>
    <sys:String x:Key="Criteria_Story_8">Превосходная история, продуманная до мелочей, интригует до конца.</sys:String>
    <sys:String x:Key="Criteria_Story_9">Гениальный сюжет, переосмысляет жанр, оставляет сильное впечатление.</sys:String>
    <sys:String x:Key="Criteria_Story_10">Шедевр повествования, безупречная структура, полное погружение.</sys:String>

    <!-- Описания для "Главные герои" -->
    <sys:String x:Key="Criteria_MainCharacters_1">Главные герои плоские, без характера, вызывают раздражение.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_2">Персонажи шаблонные, их мотивация неясна.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_3">Герои обычные, не запоминаются, но и не раздражают.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_4">Есть отдельные черты, но раскрыты слабо.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_5">Герои симпатичные, сопереживаешь им, но они не глубоки.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_6">Яркие, с чёткой мотивацией, за ними интересно следить.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_7">Харизматичные, динамично развиваются, их поступки логичны.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_8">Очень живые, с внутренними конфликтами, вызывают сильные эмоции.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_9">Персонажи гениально проработаны, становятся культовыми.</sys:String>
    <sys:String x:Key="Criteria_MainCharacters_10">Идеальные герои, воплощение лучших человеческих качеств.</sys:String>

    <!-- Описания для "Второстепенные персонажи" -->
    <sys:String x:Key="Criteria_Characters_1">Все второстепенные — безликая масса.</sys:String>
    <sys:String x:Key="Criteria_Characters_2">Шаблонные, нужны только для фона.</sys:String>
    <sys:String x:Key="Criteria_Characters_3">Есть пара интересных, но остальные не запоминаются.</sys:String>
    <sys:String x:Key="Criteria_Characters_4">Некоторые персонажи имеют характер, но слабо раскрыты.</sys:String>
    <sys:String x:Key="Criteria_Characters_5">Обычно дополняют мир, иногда забавны или трогательны.</sys:String>
    <sys:String x:Key="Criteria_Characters_6">Запоминаются, у каждого есть своя роль и история.</sys:String>
    <sys:String x:Key="Criteria_Characters_7">Хорошо прописаны, делают мир объёмным и живым.</sys:String>
    <sys:String x:Key="Criteria_Characters_8">Самобытные, с яркими характерами, вызывают симпатию.</sys:String>
    <sys:String x:Key="Criteria_Characters_9">Гениально выписаны, каждый оставляет след.</sys:String>
    <sys:String x:Key="Criteria_Characters_10">Блистательные, идеально дополняют сюжет, забыть невозможно.</sys:String>

    <!-- Описания для "Рисовка и анимация" -->
    <sys:String x:Key="Criteria_Visual_1">Рисовка ужасная, персонажи и фоны отталкивают.</sys:String>
    <sys:String x:Key="Criteria_Visual_2">Слабая анимация, много огрехов, неаккуратно.</sys:String>
    <sys:String x:Key="Criteria_Visual_3">Средний уровень, но есть заметные косяки.</sys:String>
    <sys:String x:Key="Criteria_Visual_4">Приятный глаз стиль, но анимация не впечатляет.</sys:String>
    <sys:String x:Key="Criteria_Visual_5">Хороший арт, аккуратная рисовка, но без изюминки.</sys:String>
    <sys:String x:Key="Criteria_Visual_6">Красиво, детали проработаны, движения плавные.</sys:String>
    <sys:String x:Key="Criteria_Visual_7">Очень качественно, стиль уникальный, анимация живая.</sys:String>
    <sys:String x:Key="Criteria_Visual_8">Отличная работа: фоны, дизайн, динамика — всё на высоте.</sys:String>
    <sys:String x:Key="Criteria_Visual_9">Потрясающая визуализация, почти кинематографичное качество.</sys:String>
    <sys:String x:Key="Criteria_Visual_10">Шедевр анимации, кадр можно вешать на стену.</sys:String>

    <!-- Описания для "Звук и музыка" -->
    <sys:String x:Key="Criteria_Sound_1">Звук раздражает, музыка не в тему.</sys:String>
    <sys:String x:Key="Criteria_Sound_2">Плохое качество, звуки неестественные, выбивают из атмосферы.</sys:String>
    <sys:String x:Key="Criteria_Sound_3">Средний саундтрек, ничего запоминающегося.</sys:String>
    <sys:String x:Key="Criteria_Sound_4">Неплохая музыка, но местами не попадает в сцены.</sys:String>
    <sys:String x:Key="Criteria_Sound_5">Хорошо подобрано, усиливает настроение, но без восторга.</sys:String>
    <sys:String x:Key="Criteria_Sound_6">Приятная музыка и качественные звуки, погружают.</sys:String>
    <sys:String x:Key="Criteria_Sound_7">Отличный саунд, запоминающиеся темы, точно в такт.</sys:String>
    <sys:String x:Key="Criteria_Sound_8">Блистательный саундтрек, звук идеально дополняет картинку.</sys:String>
    <sys:String x:Key="Criteria_Sound_9">Музыка живёт сама по себе, добавляет глубину, хочется переслушивать.</sys:String>
    <sys:String x:Key="Criteria_Sound_10">Безупречный звук, половина эмоций — от музыки и шумов.</sys:String>

    <!-- Описания для "Опенинг" -->
    <sys:String x:Key="Criteria_Opening_1">Скучный, безэмоциональный, хочется пропустить.</sys:String>
    <sys:String x:Key="Criteria_Opening_2">Слабая заставка, ни музыка, ни визуал не цепляют.</sys:String>
    <sys:String x:Key="Criteria_Opening_3">Средний опенинг, не плохой, но и не хороший.</sys:String>
    <sys:String x:Key="Criteria_Opening_4">Есть интересные моменты, но в целом проходной.</sys:String>
    <sys:String x:Key="Criteria_Opening_5">Хорошая музыка и визуал, поднимает настроение.</sys:String>
    <sys:String x:Key="Criteria_Opening_6">Красивый, динамичный, хочется пересматривать.</sys:String>
    <sys:String x:Key="Criteria_Opening_7">Запоминающийся, стильный, отражает суть аниме.</sys:String>
    <sys:String x:Key="Criteria_Opening_8">Отличный, заряжает энергией, стал бы слушать отдельно.</sys:String>
    <sys:String x:Key="Criteria_Opening_9">Великолепный, один из лучших, что я видел.</sys:String>
    <sys:String x:Key="Criteria_Opening_10">Идеальный опенинг — шедевр музыки и анимации.</sys:String>

    <!-- Описания для "Эндинг" -->
    <sys:String x:Key="Criteria_Ending_1">Скучный, безэмоциональный, хочется пропустить.</sys:String>
    <sys:String x:Key="Criteria_Ending_2">Слабая заставка, ни музыка, ни визуал не цепляют.</sys:String>
    <sys:String x:Key="Criteria_Ending_3">Средний эндинг, не плохой, но и не хороший.</sys:String>
    <sys:String x:Key="Criteria_Ending_4">Есть интересные моменты, но в целом проходной.</sys:String>
    <sys:String x:Key="Criteria_Ending_5">Хорошая музыка и визуал, поднимает настроение.</sys:String>
    <sys:String x:Key="Criteria_Ending_6">Красивый, динамичный, хочется пересматривать.</sys:String>
    <sys:String x:Key="Criteria_Ending_7">Запоминающийся, стильный, отражает суть аниме.</sys:String>
    <sys:String x:Key="Criteria_Ending_8">Отличный, заряжает энергией, стал бы слушать отдельно.</sys:String>
    <sys:String x:Key="Criteria_Ending_9">Великолепный, один из лучших, что я видел.</sys:String>
    <sys:String x:Key="Criteria_Ending_10">Идеальный эндинг — шедевр музыки и анимации.</sys:String>

    <!-- Описания для "Эмоциональное воздействие" -->
    <sys:String x:Key="Criteria_Emotions_1">Не вызывает никаких эмоций, сухо и безразлично.</sys:String>
    <sys:String x:Key="Criteria_Emotions_2">Почти не трогает, чувства проходят мимо.</sys:String>
    <sys:String x:Key="Criteria_Emotions_3">Редкие проблески эмоций, но в основном равнодушно.</sys:String>
    <sys:String x:Key="Criteria_Emotions_4">Некоторые сцены задевают, но в целом слабо.</sys:String>
    <sys:String x:Key="Criteria_Emotions_5">Средняя эмоциональность, сопереживаешь, но без сильных потрясений.</sys:String>
    <sys:String x:Key="Criteria_Emotions_6">Погружает в переживания, вызывает живые чувства.</sys:String>
    <sys:String x:Key="Criteria_Emotions_7">Захватывает, заставляет радоваться, грустить, волноваться.</sys:String>
    <sys:String x:Key="Criteria_Emotions_8">Очень сильное впечатление, сцены остаются в памяти.</sys:String>
    <sys:String x:Key="Criteria_Emotions_9">Пробивает до глубины души, вызывает слёзы или смех.</sys:String>
    <sys:String x:Key="Criteria_Emotions_10">Невероятная эмоциональная мощь, переворачивает душу.</sys:String>

    <!-- Описания для "Оригинальность" -->
    <sys:String x:Key="Criteria_Originality_1">Полный клон других аниме, ничего нового.</sys:String>
    <sys:String x:Key="Criteria_Originality_2">Почти всё заимствовано, новизна близка к нулю.</sys:String>
    <sys:String x:Key="Criteria_Originality_3">Есть пара свежих идей, но в целом шаблонно.</sys:String>
    <sys:String x:Key="Criteria_Originality_4">Необычные моменты, но основа банальна.</sys:String>
    <sys:String x:Key="Criteria_Originality_5">Обычный жанровый подход, но с небольшими находками.</sys:String>
    <sys:String x:Key="Criteria_Originality_6">Заметно отличается от среднего, есть свой стиль.</sys:String>
    <sys:String x:Key="Criteria_Originality_7">Оригинально, интригует, неожиданные решения.</sys:String>
    <sys:String x:Key="Criteria_Originality_8">Уникальный мир, свежий взгляд, переосмысляет жанр.</sys:String>
    <sys:String x:Key="Criteria_Originality_9">Редкая оригинальность, концепция удивляет и вдохновляет.</sys:String>
    <sys:String x:Key="Criteria_Originality_10">Гениально, ничего подобного не существовало.</sys:String>

    <!-- Описания для "Финал" -->
    <sys:String x:Key="Criteria_Finale_1">Концовка ужасна, всё испортила.</sys:String>
    <sys:String x:Key="Criteria_Finale_2">Очень слабая, смазала всё впечатление.</sys:String>
    <sys:String x:Key="Criteria_Finale_3">Посредственный финал, не соответствует развитию.</sys:String>
    <sys:String x:Key="Criteria_Finale_4">Неплохо, но слишком предсказуемо и плоско.</sys:String>
    <sys:String x:Key="Criteria_Finale_5">Нормальный финал, без восторга, но и не разочаровывает.</sys:String>
    <sys:String x:Key="Criteria_Finale_6">Хорошо завершает сюжет, все линии закрыты.</sys:String>
    <sys:String x:Key="Criteria_Finale_7">Отличная концовка, оставляет приятное послевкусие.</sys:String>
    <sys:String x:Key="Criteria_Finale_8">Сильный финал, запоминается и радует.</sys:String>
    <sys:String x:Key="Criteria_Finale_9">Великолепный, трудно забыть, вызывает восхищение.</sys:String>
    <sys:String x:Key="Criteria_Finale_10">Идеальный финал — всё завершено мастерски, оставляет чувство глубокого удовлетворения.</sys:String>

    <!-- Статистика -->
