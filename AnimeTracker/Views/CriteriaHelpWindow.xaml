<Window x:Class="AnimeTracker.Views.CriteriaHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CriteriaHelp_Title}" Height="500" Width="750"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" Topmost="False">
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource CriteriaHelp_Title}" Foreground="White" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" Style="{DynamicResource WindowButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="15" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource CriteriaHelp_Header}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding CriteriaList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="10" Margin="0,0,20,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentLightBrush}" FontSize="16" FontWeight="Bold"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Descriptions}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                                                        <Run Text="{Binding Score, StringFormat='{}{0:D}:'}" Foreground="White" FontWeight="Bold"/>
                                                        <Run Text=" " />
                                                        <Run Text="{Binding Text}" Foreground="LightGray"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>