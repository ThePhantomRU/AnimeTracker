<Window x:Class="AnimeTracker.MainWindow"
        WindowStartupLocation="CenterScreen"
        MinWidth="900"
        MinHeight="700"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AnimeTracker.ViewModels"
        xmlns:converters="clr-namespace:AnimeTracker.Converters"
        xmlns:views="clr-namespace:AnimeTracker.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:AnimeTracker"
        Title="Anime Tracker" Height="850" Width="1350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Closing="Window_Closing"
        SizeChanged="MainWindow_SizeChanged"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontWeight="SemiBold"
        KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="4" CornerRadius="20"
                            GlassFrameThickness="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" Background="{DynamicResource WindowBackground}" CornerRadius="20"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{DynamicResource WindowShadow}" ClipToBounds="True">

        <Grid>
            <Grid.Resources>
                <converters:StringListConverter x:Key="StringListConverter"/>
                <converters:AnimeGenresConverter x:Key="AnimeGenresConverter"/>
                <converters:AnimeEpisodesConverter x:Key="AnimeEpisodesConverter"/>
                <converters:IndexPlusOneConverter x:Key="IndexPlusOneConverter"/>
                <converters:StatusLocalizationConverter x:Key="StatusLocalizationConverter"/>
                <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
                <converters:StatusForegroundConverter x:Key="StatusForegroundConverter"/>
                <converters:ScoreDescriptionConverter x:Key="ScoreDescriptionConverter"/>
                <converters:IntZeroToEmptyConverter x:Key="IntZeroToEmptyConverter"/>
                <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
                <converters:ValueToWidthConverter x:Key="ValueToWidthConverter"/>
                <local:ScoreToStarWidthConverter x:Key="ScoreToStarWidthConverter"/>

                <DataTemplate x:Key="ScoreBarItemTemplate">
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding FillPortion, Converter={StaticResource ScoreToStarWidthConverter}}"/>
                                <ColumnDefinition Width="{Binding RemainingPortion, Converter={StaticResource ScoreToStarWidthConverter}}"/>
                            </Grid.ColumnDefinitions>
                            <!-- Цвет полосы берётся из темы (AccentBrush); тёмный градиент поверх сохраняет объём -->
                            <Grid Grid.Column="0">
                                <Border CornerRadius="6" Background="{DynamicResource AccentBrush}"/>
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#59000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DisplayValue}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="BarItemTemplateScore">
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="12" 
                                   VerticalAlignment="Center" Margin="0,0,8,0" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="140" 
                                   ToolTip="{Binding Name}"/>
                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" 
                                CornerRadius="3" Height="18" 
                                Width="{Binding WidthPercent, Converter={StaticResource ValueToWidthConverter}}"
                                HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F2}}" 
                                   Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="BarItemTemplateCount">
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="12" 
                                   VerticalAlignment="Center" Margin="0,0,8,0" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="140" 
                                   ToolTip="{Binding Name}"/>
                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" 
                                CornerRadius="3" Height="18" 
                                Width="{Binding WidthPercent, Converter={StaticResource ValueToWidthConverter}}"
                                HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F0}}" 
                                   Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>

                <Style TargetType="ContextMenu">
                    <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                        BorderThickness="0" 
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="4">
                                    <DockPanel>
                                        <ContentPresenter x:Name="HeaderPresenter" 
                                                          ContentSource="Header"
                                                          DockPanel.Dock="Left"/>
                                        <Path x:Name="SubmenuArrow" 
                                              Data="M0,0 L4,4 L8,0" 
                                              Stroke="{DynamicResource TextPrimary}" 
                                              StrokeThickness="1.5" 
                                              DockPanel.Dock="Right" 
                                              Margin="8,0,0,0"
                                              Visibility="Collapsed"/>
                                        <Popup x:Name="Popup" 
                                               Placement="Right" 
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               AllowsTransparency="True"
                                               Focusable="False">
                                            <Border Background="{DynamicResource PanelBackground}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6">
                                                <ItemsPresenter/>
                                            </Border>
                                        </Popup>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="SettingsButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="DangerSettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
                    <Setter Property="Background" Value="#D32F2F"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F44336"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackground}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ANIME TRACKER" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Style="{DynamicResource TitleBarButton}" Click="Minimize_Click"/>
                    <Button Content="□" Style="{DynamicResource TitleBarButton}" Click="MaximizeRestore_Click"/>
                    <Button Content="✕" Style="{DynamicResource TitleBarCloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="Auto" MinWidth="60" MaxWidth="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Боковая панель -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Width="280"
                        Background="{DynamicResource NavigationBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="ToggleSidebarButton" Content="☰"
                                Style="{DynamicResource SidebarToggleButton}"
                                Click="ToggleSidebarButton_Click"
                                HorizontalAlignment="Left" Margin="8,8,0,0"
                                ToolTip="Свернуть панель"/>

                        <!-- Панель поиска -->
                        <Border x:Name="SearchPanel" Grid.Row="1" Margin="16,12,16,8" Height="40"
                                Visibility="Visible"
                                Background="{DynamicResource PanelBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <TextBox x:Name="SearchTextBoxPlan"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource SearchTextBox}"
                                         TextChanged="SearchBox_TextChanged"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0,0,0"
                                         VerticalContentAlignment="Center"/>
                                <TextBox x:Name="SearchTextBoxTop"
                                         Style="{DynamicResource SearchTextBox}"
                                         Visibility="Collapsed"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Text="{Binding SearchTextTop, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,0,0,0"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Search_Placeholder}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="12,0,0,0" IsHitTestVisible="False"
                                           x:Name="SearchPlaceholder"/>
                            </Grid>
                        </Border>

                        <!-- Иконка поиска для свёрнутой панели -->
                        <Button x:Name="SearchIconButton" Grid.Row="1"
                                Content="🔍"
                                Style="{DynamicResource SidebarToggleButton}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="28" Height="28" FontSize="14"
                                Visibility="Collapsed"
                                Click="SearchIconButton_Click"
                                IsEnabled="False"
                                Margin="8,8,8,8"
                                ToolTip="Поиск"/>

                        <!-- Навигация -->
                        <StackPanel Grid.Row="2" Margin="8,0" x:Name="NavigationStack">
                            <RadioButton x:Name="PlanTab" x:FieldModifier="public" Content="{DynamicResource Tab_Plan}" Style="{DynamicResource NavRadioButton}"
                                         IsChecked="True" Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_PlanTab}"/>
                            <RadioButton x:Name="RatingTab" x:FieldModifier="public" Content="{DynamicResource Tab_Rating}" Style="{DynamicResource NavRadioButton}"
                                         Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_RatingTab}"/>
                            <RadioButton x:Name="TopTab" x:FieldModifier="public" Content="{DynamicResource Tab_Top}" Style="{DynamicResource NavRadioButton}"
                                         Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_TopTab}"/>
                            <RadioButton x:Name="StatsTab" x:FieldModifier="public" Content="{DynamicResource Tab_Statistics}" Style="{DynamicResource NavRadioButton}"
                                         Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_StatsTab}"/>
                            <RadioButton x:Name="InstructionsTab" x:FieldModifier="public" Content="{DynamicResource Tab_Instructions}" Style="{DynamicResource NavRadioButton}"
                                         Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_InstructionsTab}"/>
                            <RadioButton x:Name="SettingsTab" x:FieldModifier="public" Content="{DynamicResource Tab_Settings}" Style="{DynamicResource NavRadioButton}"
                                         Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_SettingsTab}"/>
                            <RadioButton x:Name="AboutTab" x:FieldModifier="public" Content="{DynamicResource Tab_About}" Style="{DynamicResource NavRadioButton}"
                                         Checked="NavRadioButton_Checked"
                                         ToolTip="{DynamicResource ToolTip_AboutTab}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Контентная область -->
                <Grid Grid.Column="1" Background="{DynamicResource ContentBackground}">
                    <Grid x:Name="PageContainer">

                        <!-- ==================== ПЛАН ==================== -->
                        <Border x:Name="PlanPage" Visibility="Visible" Margin="24" RenderTransformOrigin="0.5,0.5"
                                PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Border.RenderTransform>
                            <Border Background="{DynamicResource PanelBackground}" CornerRadius="14" Padding="24"
                                    Effect="{DynamicResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{DynamicResource Plan_PageTitle}" FontSize="22" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <Grid HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="{DynamicResource Button_Random}" Style="{DynamicResource ToolbarButton}" Width="150" Height="40" Command="{Binding RandomCommand}" HorizontalAlignment="Left" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{DynamicResource Button_Add}" Style="{DynamicResource AccentButton}" Margin="0,0,8,0" Width="150" Height="40" Click="AddAnime_Click"/>
                                                <Button Content="{DynamicResource Button_TempRating}" Style="{DynamicResource ToolbarButton}" Margin="0,0,8,0" Width="150" Height="40" Click="TempRating_Click"/>
                                                <Button Content="{DynamicResource Button_Edit}" Style="{DynamicResource ToolbarButton}" Margin="0,0,8,0" Width="150" Height="40" Command="{Binding EditPlanAnimeCommand}"/>
                                                <Button Content="{DynamicResource Button_Delete}" Style="{DynamicResource DangerButton}" Width="150" Height="40" Command="{Binding DeleteCommand}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{DynamicResource Button_Share}" Style="{DynamicResource ToolbarButton}"
                                                    Width="150" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource ToolTip_Share}" Click="SharePlan_Click"/>
                                        </Grid>
                                    </StackPanel>
                                    <Border Grid.Row="2" Margin="0,10,0,15" Padding="15" Background="{DynamicResource PanelBackground}"
                                            CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Plan_TodaysChoice}" Foreground="{DynamicResource AccentLightBrush}" FontSize="14"/>
                                                <TextBlock Text="{Binding RandomText}" Foreground="{DynamicResource TextPrimary}" FontSize="22" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" MinWidth="180" MaxWidth="280" Height="30" Margin="16,0,4,0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True"
                                                      ItemsSource="{Binding RandomGenreOptions}"
                                                      SelectedItem="{Binding SelectedRandomGenre}"
                                                      Style="{DynamicResource RoundedComboBox}"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="PlanTableCard" Grid.Row="3" Background="#20FFFFFF" CornerRadius="14" Padding="0"
                                            SizeChanged="TableCard_SizeChanged" Loaded="TableCard_Loaded">
                                        <DataGrid x:Name="PlanDataGrid" 
                                                  Margin="0"
                                                  ItemsSource="{Binding PlanList}"
                                                  SelectedItem="{Binding SelectedAnime}" 
                                                  AutoGenerateColumns="False" 
                                                  IsReadOnly="True"
                                                  CanUserSortColumns="False"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="False"
                                                  ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.CacheLength="6"
                                                  VirtualizingPanel.CacheLengthUnit="Item"
                                                  Background="Transparent"
                                                  GridLinesVisibility="None"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  RowHeaderWidth="0"
                                                  SelectionUnit="FullRow"
                                                  SelectionMode="Single"
                                                  HorizontalAlignment="Stretch">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource PanelBackground}">
                                                    <MenuItem Header="{DynamicResource Button_Edit}" Command="{Binding EditPlanAnimeCommand}" Background="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Separator Background="{DynamicResource BorderBrush}"/>
                                                    <MenuItem Header="{DynamicResource Button_TempRating}" Click="TempRating_Click" Background="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Separator Background="{DynamicResource BorderBrush}"/>
                                                    <MenuItem Header="{DynamicResource Button_Delete}" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <!-- Название -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Title}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Title"
                                                                        Width="2*" MinWidth="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Title}" 
                                                                       TextWrapping="Wrap" 
                                                                       VerticalAlignment="Center" 
                                                                       Margin="4,2"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Жанры -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Genres}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Genres"
                                                                        Width="1.5*" MinWidth="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource AnimeGenresConverter}}" 
                                                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Эпизоды -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Episodes}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Episodes"
                                                                        Width="1.5*" MinWidth="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="EpisodesText" 
                                                                           Text="{Binding Converter={StaticResource AnimeEpisodesConverter}}"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,2"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           Loaded="EpisodesTextBlock_Loaded"
                                                                           SizeChanged="EpisodesTextBlock_SizeChanged"
                                                                           DataContextChanged="EpisodesTextBlock_DataContextChanged"/>
                                                                <Button x:Name="EpisodesToggleButton" Grid.Column="1" 
                                                                        Content="…" Width="20" Height="20" FontSize="12"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                        Tag="EpisodesToggle" Click="EpisodesButton_Click"
                                                                        Background="#40FFFFFF" Foreground="{DynamicResource TextPrimary}"
                                                                        BorderThickness="0" Cursor="Hand" Padding="0"
                                                                        Visibility="Collapsed"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Год -->
                                                <DataGridTextColumn Header="{DynamicResource Label_Year}" 
                                                                    local:ColumnExtensions.ResourceKey="Label_Year"
                                                                    Binding="{Binding YearsDisplay, Mode=OneWay}" 
                                                                    Width="0.7*" MinWidth="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Озвучка -->
                                                <DataGridTextColumn Header="{DynamicResource Label_VoiceOver}" 
                                                                    local:ColumnExtensions.ResourceKey="Label_VoiceOver"
                                                                    Binding="{Binding VoiceOver}" 
                                                                    Width="1*" MinWidth="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Описание -->
                                                <DataGridTemplateColumn x:Name="PlanDescriptionColumn" 
                                                                        Header="{DynamicResource Label_Description}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Description"
                                                                        Width="3*" MinWidth="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="DescText" Text="{Binding Description}" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           Loaded="DescriptionTextBlock_Loaded"
                                                                           SizeChanged="DescriptionTextBlock_SizeChanged"
                                                                           DataContextChanged="DescriptionTextBlock_DataContextChanged"/>
                                                                <Button x:Name="ToggleButton" Grid.Column="1" Content="…" Width="20" Height="20" FontSize="12"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                        Tag="DescriptionToggle" Click="DescriptionButton_Click"
                                                                        Background="#40FFFFFF" Foreground="{DynamicResource TextPrimary}"
                                                                        BorderThickness="0" Cursor="Hand" Padding="0"
                                                                        Visibility="Collapsed"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Статус -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Status}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Status"
                                                                        Width="Auto" MinWidth="90" IsReadOnly="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusLocalizationConverter}}" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.LocalizedStatusList, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource StatusLocalizationConverter}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataGridTemplateColumn.CellStyle>
                                                        <!-- Цвет плашки статуса и цвет текста задаются конвертерами (быстрее, чем 12 триггеров на строку) -->
                                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                            <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusForegroundConverter}}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="DataGridCell">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                                            <Border x:Name="CellBorder" CornerRadius="12" Margin="2" Padding="6,2"
                                                                                    Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </DataGridTemplateColumn.CellStyle>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- ==================== ОЦЕНКА ==================== -->
                        <Border x:Name="RatingPage" Visibility="Collapsed" Margin="24" RenderTransformOrigin="0.5,0.5"
                                PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Border.RenderTransform>
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Rating_Evaluating}" Foreground="{DynamicResource AccentLightBrush}" FontSize="14"/>
                                            <TextBlock Text="{Binding SelectedForRating.Title}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedForRating.Genre}" Foreground="{DynamicResource AccentLightBrush}" FontSize="16" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding SelectedForRating.AdditionalGenres, Converter={StaticResource StringListConverter}}" 
                                                       Foreground="{DynamicResource AccentLightBrush}" FontSize="14" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="❓" Width="30" Height="30" Style="{DynamicResource WindowButtonStyle}" 
                                                Click="ShowCriteriaHelp_Click" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SelectedForRating.Description}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{DynamicResource AccentLightBrush}" FontSize="14">
                                        <Run Text="{DynamicResource Rating_VoiceOver}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SelectedForRating.VoiceOver}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TabControl Grid.Row="2" x:Name="RatingPartsTabControl"
                                            Background="Transparent" BorderBrush="Transparent">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="12,6"/>
                                            <Setter Property="Margin" Value="2,0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="IsSelected" Value="False"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PanelBackground}"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.Resources>
                                </TabControl>
                                <StackPanel Grid.Row="3" Margin="0,20,0,0">
                                    <Button Content="{DynamicResource Button_SaveRating}" Height="40" Click="SaveRatingButton_Click"/>
                                    <Button Content="{DynamicResource Button_CancelRating}" Height="40" Margin="0,10,0,0" 
                                            Command="{Binding CancelRatingCommand}" Background="#D32F2F"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ==================== ТОП ==================== -->
                        <Border x:Name="TopPage" Visibility="Collapsed" Margin="24" RenderTransformOrigin="0.5,0.5"
                                PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Border.RenderTransform>
                            <Border Background="{DynamicResource PanelBackground}" CornerRadius="14" Padding="24"
                                    Effect="{DynamicResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Top_PageTitle}" FontSize="22" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{DynamicResource Button_ReEvaluate}" Style="{DynamicResource ToolbarButton}" Width="160" Height="40" Margin="0,0,8,0" Command="{Binding ReEvaluateCommand}"/>
                                                <Button Content="{DynamicResource Button_Edit}" Style="{DynamicResource ToolbarButton}" Width="160" Height="40" Margin="0,0,8,0" Command="{Binding EditTopAnimeCommand}"/>
                                                <Button Content="{DynamicResource Button_DeleteFromTop}" Style="{DynamicResource DangerButton}" Width="180" Height="38" Command="{Binding DeleteFromTopCommand}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{DynamicResource Button_Share}" Style="{DynamicResource ToolbarButton}"
                                                    Width="150" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource ToolTip_Share}" Click="ShareTop_Click"/>
                                        </Grid>
                                    </StackPanel>
                                    <Border x:Name="TopTableCard" Grid.Row="1" Background="#20FFFFFF" CornerRadius="14" Padding="0" Margin="0,10,0,0"
                                            SizeChanged="TableCard_SizeChanged" Loaded="TableCard_Loaded">
                                        <DataGrid x:Name="TopDataGrid"
                                                  Margin="0"
                                                  ItemsSource="{Binding FilteredTopList}" SelectedItem="{Binding SelectedTopAnime}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserSortColumns="False"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="False"
                                                  ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.CacheLength="6"
                                                  VirtualizingPanel.CacheLengthUnit="Item"
                                                  Background="Transparent"
                                                  GridLinesVisibility="None"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  RowHeaderWidth="0"
                                                  SelectionUnit="FullRow"
                                                  SelectionMode="Single"
                                                  HorizontalAlignment="Stretch">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource PanelBackground}">
                                                    <MenuItem Header="{DynamicResource Button_Edit}" Command="{Binding EditTopAnimeCommand}" Background="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Separator Background="{DynamicResource BorderBrush}"/>
                                                    <MenuItem Header="{DynamicResource Button_ReEvaluate}" Command="{Binding ReEvaluateCommand}" Background="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Separator Background="{DynamicResource BorderBrush}"/>
                                                    <MenuItem Header="{DynamicResource Button_DeleteFromTop}" Command="{Binding DeleteFromTopCommand}" Background="Transparent" Foreground="{DynamicResource TextPrimary}"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Rank}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Rank"
                                                                        Width="50" MinWidth="40">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Normal">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                                                            <GradientStop Color="#FFD700" Offset="0.0"/>
                                                                                            <GradientStop Color="#FFF8DC" Offset="0.5"/>
                                                                                            <GradientStop Color="#FFD700" Offset="1.0"/>
                                                                                            <LinearGradientBrush.RelativeTransform>
                                                                                                <TranslateTransform X="0" />
                                                                                            </LinearGradientBrush.RelativeTransform>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" 
                                                                                                             From="0" To="1" Duration="0:0:3"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                                                            <GradientStop Color="#C0C0C0" Offset="0.0"/>
                                                                                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                                                                            <GradientStop Color="#C0C0C0" Offset="1.0"/>
                                                                                            <LinearGradientBrush.RelativeTransform>
                                                                                                <TranslateTransform X="0" />
                                                                                            </LinearGradientBrush.RelativeTransform>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" 
                                                                                                             From="0" To="1" Duration="0:0:3"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                                                            <GradientStop Color="#CD7F32" Offset="0.0"/>
                                                                                            <GradientStop Color="#E9967A" Offset="0.5"/>
                                                                                            <GradientStop Color="#CD7F32" Offset="1.0"/>
                                                                                            <LinearGradientBrush.RelativeTransform>
                                                                                                <TranslateTransform X="0" />
                                                                                            </LinearGradientBrush.RelativeTransform>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" 
                                                                                                             From="0" To="1" Duration="0:0:3"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Название -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Title}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Title"
                                                                        Width="2*" MinWidth="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Title}" 
                                                                       TextWrapping="Wrap" 
                                                                       VerticalAlignment="Center" 
                                                                       Margin="4,2">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                                                            <GradientStop Color="#FFD700" Offset="0.0"/>
                                                                                            <GradientStop Color="#FFF8DC" Offset="0.5"/>
                                                                                            <GradientStop Color="#FFD700" Offset="1.0"/>
                                                                                            <LinearGradientBrush.RelativeTransform>
                                                                                                <TranslateTransform X="0" />
                                                                                            </LinearGradientBrush.RelativeTransform>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" 
                                                                                                             From="0" To="1" Duration="0:0:3"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                                                            <GradientStop Color="#C0C0C0" Offset="0.0"/>
                                                                                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                                                                            <GradientStop Color="#C0C0C0" Offset="1.0"/>
                                                                                            <LinearGradientBrush.RelativeTransform>
                                                                                                <TranslateTransform X="0" />
                                                                                            </LinearGradientBrush.RelativeTransform>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" 
                                                                                                             From="0" To="1" Duration="0:0:3"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                                                            <GradientStop Color="#CD7F32" Offset="0.0"/>
                                                                                            <GradientStop Color="#E9967A" Offset="0.5"/>
                                                                                            <GradientStop Color="#CD7F32" Offset="1.0"/>
                                                                                            <LinearGradientBrush.RelativeTransform>
                                                                                                <TranslateTransform X="0" />
                                                                                            </LinearGradientBrush.RelativeTransform>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" 
                                                                                                             From="0" To="1" Duration="0:0:3"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Жанры -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Genres}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Genres"
                                                                        Width="1.5*" MinWidth="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource AnimeGenresConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2" Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Эпизоды -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Episodes}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Episodes"
                                                                        Width="1.5*" MinWidth="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="EpisodesText" 
                                                                           Text="{Binding Converter={StaticResource AnimeEpisodesConverter}}"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,2"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           Loaded="EpisodesTextBlock_Loaded"
                                                                           SizeChanged="EpisodesTextBlock_SizeChanged"
                                                                           DataContextChanged="EpisodesTextBlock_DataContextChanged"/>
                                                                <Button x:Name="EpisodesToggleButton" Grid.Column="1" 
                                                                        Content="…" Width="20" Height="20" FontSize="12"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                        Tag="EpisodesToggle" Click="EpisodesButton_Click"
                                                                        Background="#40FFFFFF" Foreground="{DynamicResource TextPrimary}"
                                                                        BorderThickness="0" Cursor="Hand" Padding="0"
                                                                        Visibility="Collapsed"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Год -->
                                                <DataGridTextColumn Header="{DynamicResource Label_Year}" 
                                                                    local:ColumnExtensions.ResourceKey="Label_Year"
                                                                    Binding="{Binding YearsDisplay, Mode=OneWay}" 
                                                                    Width="0.7*" MinWidth="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Озвучка -->
                                                <DataGridTextColumn Header="{DynamicResource Label_VoiceOver}" 
                                                                    local:ColumnExtensions.ResourceKey="Label_VoiceOver"
                                                                    Binding="{Binding VoiceOver}" 
                                                                    Width="1*" MinWidth="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Описание -->
                                                <DataGridTemplateColumn x:Name="TopDescriptionColumn" 
                                                                        Header="{DynamicResource Label_Description}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Description"
                                                                        Width="3*" MinWidth="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="DescText" Text="{Binding Description}" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           Loaded="DescriptionTextBlock_Loaded"
                                                                           SizeChanged="DescriptionTextBlock_SizeChanged"
                                                                           DataContextChanged="DescriptionTextBlock_DataContextChanged"/>
                                                                <Button x:Name="ToggleButton" Grid.Column="1" Content="…" Width="20" Height="20" FontSize="12"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                        Tag="DescriptionToggle" Click="DescriptionButton_Click"
                                                                        Background="#40FFFFFF" Foreground="{DynamicResource TextPrimary}"
                                                                        BorderThickness="0" Cursor="Hand" Padding="0"
                                                                        Visibility="Collapsed"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Счёт -->
                                                <DataGridTemplateColumn Header="{DynamicResource Label_Score}" 
                                                                        local:ColumnExtensions.ResourceKey="Label_Score"
                                                                        Width="Auto" MinWidth="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding AdjustedScore, StringFormat={}{0:F2}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellStyle>
                                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                            <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
                                                            <Setter Property="ToolTipService.BetweenShowDelay" Value="1000"/>
                                                            <Setter Property="ToolTip">
                                                                <Setter.Value>
                                                                    <TextBlock>
                                                                        <Run Text="{DynamicResource ToolTip_ExactScore}" Foreground="{DynamicResource TextPrimary}"/>
                                                                        <Run Text="{Binding AdjustedScore, StringFormat={}{0:F4}}" Foreground="{DynamicResource AccentLightBrush}"/>
                                                                    </TextBlock>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </DataGridTemplateColumn.CellStyle>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- ==================== СТАТИСТИКА ==================== -->
                        <Border x:Name="StatsPage" Visibility="Collapsed" Margin="24" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Border.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <StackPanel Margin="0,10,0,20">
                                    <TextBlock Text="{DynamicResource Statistics_General}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Stats_Hint}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20" FontStyle="Italic"/>
                                    <WrapPanel Margin="0,0,0,20" HorizontalAlignment="Stretch">
                                        <!-- Карточки сводки (без изменений) -->
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="15" Margin="5" Effect="{DynamicResource CardShadow}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Stats_DistributionTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"
                                                           ToolTipService.InitialShowDelay="500">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" MaxWidth="300">
