<Window x:Class="AnimeTracker.Views.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лицензионное соглашение" Height="500" Width="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Closing="Window_Closing" ShowInTaskbar="False" Topmost="True"
        StateChanged="Window_StateChanged">
    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Лицензионное соглашение" Foreground="White" FontWeight="SemiBold" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Текст лицензии -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <TextBlock x:Name="LicenseTextBlock" Foreground="White" FontSize="12" 
                               TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>

                <!-- Кнопки -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Принять" Width="120" Height="35" Click="Accept_Click" IsDefault="True" Margin="0,0,10,0"/>
                    <Button Content="Отказаться" Width="120" Height="35" Click="Decline_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>