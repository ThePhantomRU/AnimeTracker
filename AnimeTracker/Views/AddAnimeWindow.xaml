<Window x:Class="AnimeTracker.Views.AddAnimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AnimeTracker.Converters"
        Title="{DynamicResource AddAnime_Title}" Height="700" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <converters:IndexPlusOneConverter x:Key="IndexPlusOneConverter"/>
        <converters:IntZeroToEmptyConverter x:Key="IntZeroToEmptyConverter"/>
    </Window.Resources>
    <Border Background="{StaticResource WindowBackground}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource AccentBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource AddAnime_Title}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" Style="{StaticResource WindowButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="{DynamicResource AddAnime_BasicInfo}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Название -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="White" Margin="3,0,0,2">
                                <Run Text="{DynamicResource Label_Title}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Text="{Binding AnimeTitle, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource RoundedTextBox}" 
                                     Width="220" Height="35" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Жанр -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="White" Margin="3,0,0,2">
                                <Run Text="{DynamicResource Label_Genre}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding GenreOptions}" 
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding GenreKey}"
                                      Style="{StaticResource RoundedComboBox}" 
                                      Width="150" Height="35" VerticalContentAlignment="Center"
                                      SelectionChanged="Genre_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Озвучка -->
                        <StackPanel Margin="0">
                            <TextBlock Foreground="White" Margin="3,0,0,2">
                                <Run Text="{DynamicResource Label_VoiceOver}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Text="{Binding VoiceOver, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource RoundedTextBox}" 
                                     Width="150" Height="35" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Дополнительные жанры -->
                    <TextBlock Text="{DynamicResource AddAnime_AdditionalGenres}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="3,15,0,5"/>
                    <ItemsControl x:Name="AdditionalGenresItemsControl" ItemsSource="{Binding TempAdditionalGenres}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,3">
                                    <TextBlock Foreground="White" Width="80" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}:">
                                                <Binding Source="{StaticResource AddAnime_AdditionalGenrePrefix}"/>
                                                <Binding Path="Index" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding AvailableGenreOptions}" 
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedGenreKey}"
                                              Width="140" Style="{StaticResource RoundedComboBox}"
                                              SelectionChanged="AdditionalGenre_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="🗑" Width="40" Height="30" Margin="5,0,0,0" 
        Click="RemoveAdditionalGenre_Click" Tag="{Binding}" 
        Background="Transparent" Foreground="White" BorderThickness="0" 
        Cursor="Hand" FontSize="14"/>
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource AddAnime_AddGenreButton}" 
                            Margin="3,5,0,0" Click="AddAdditionalGenre_Click" 
                            Width="180" HorizontalAlignment="Left" Padding="8,4"/>

                    <!-- Эпизоды и статус -->
                    <TextBlock Text="{DynamicResource AddAnime_EpisodesStatus}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="3" Width="100">
                            <TextBlock Foreground="White">
                                <Run Text="{DynamicResource Label_Seasons}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Text="{Binding SeasonsCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" MaxLength="3"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="3" Width="100">
                            <TextBlock Foreground="White">
                                <Run Text="{DynamicResource Label_Movies}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Text="{Binding MoviesCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" MaxLength="3"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="3" Width="100">
                            <TextBlock Foreground="White">
                                <Run Text="{DynamicResource Label_OVA}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Text="{Binding OvasCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" MaxLength="3"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="3" Width="100">
                            <TextBlock Foreground="White">
                                <Run Text="{DynamicResource Label_ONA}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Text="{Binding OnasCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" MaxLength="3"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                        <!-- Статус -->
                        <StackPanel Margin="3">
                            <TextBlock Foreground="White">
                                <Run Text="{DynamicResource Label_Status}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding StatusOptions}" 
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding StatusKey}"
                                      Style="{StaticResource RoundedComboBox}" 
                                      Width="150" Height="35" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Детали по сезонам/фильмам/OVA/ONA -->
                    <TextBlock Text="{DynamicResource AddAnime_Details}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                    <ItemsControl ItemsSource="{Binding TempSeasons}" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,5">
                                    <TextBlock Foreground="White" Width="80">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}]">
                                                <Binding Source="{StaticResource Label_SeasonPrefix}"/>
                                                <Binding Path="(ItemsControl.AlternationIndex)" 
                                                         RelativeSource="{RelativeSource TemplatedParent}"
                                                         Converter="{StaticResource IndexPlusOneConverter}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBox Text="{Binding EpisodeCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                    <TextBlock Text="{StaticResource Label_EpisodesPerSeason}" Foreground="White" Margin="5,0"/>
                                    <TextBox Text="{Binding Year, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding TempMovies}" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,5">
                                    <TextBlock Foreground="White" Width="80">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}]">
                                                <Binding Source="{StaticResource Label_MoviePrefix}"/>
                                                <Binding Path="(ItemsControl.AlternationIndex)" 
                                                         RelativeSource="{RelativeSource TemplatedParent}"
                                                         Converter="{StaticResource IndexPlusOneConverter}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{StaticResource Label_YearOnly}" Foreground="White" Margin="5,0"/>
                                    <TextBox Text="{Binding Year, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding TempOvas}" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,5">
                                    <TextBlock Foreground="White" Width="80">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}]">
                                                <Binding Source="{StaticResource Label_OVAPrefix}"/>
                                                <Binding Path="(ItemsControl.AlternationIndex)" 
                                                         RelativeSource="{RelativeSource TemplatedParent}"
                                                         Converter="{StaticResource IndexPlusOneConverter}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBox Text="{Binding EpisodeCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                    <TextBlock Text="{StaticResource Label_EpisodesPerSeason}" Foreground="White" Margin="5,0"/>
                                    <TextBox Text="{Binding Year, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding TempOnas}" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,5">
                                    <TextBlock Foreground="White" Width="80">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}]">
                                                <Binding Source="{StaticResource Label_ONAPrefix}"/>
                                                <Binding Path="(ItemsControl.AlternationIndex)" 
                                                         RelativeSource="{RelativeSource TemplatedParent}"
                                                         Converter="{StaticResource IndexPlusOneConverter}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBox Text="{Binding EpisodeCount, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                    <TextBlock Text="{StaticResource Label_EpisodesPerSeason}" Foreground="White" Margin="5,0"/>
                                    <TextBox Text="{Binding Year, Converter={StaticResource IntZeroToEmptyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="60" Margin="5,0" PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                             Style="{StaticResource RoundedTextBox}"/>
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource AddAnime_DescriptionOnly}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                    <StackPanel Margin="3,0,0,0">
                        <TextBlock Foreground="White">
                            <Run Text="{DynamicResource Label_Description}"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="100" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource RoundedTextBox}"
                                 PreviewMouseWheel="DescriptionTextBox_PreviewMouseWheel"/>
                    </StackPanel>

                    <Button Content="{DynamicResource Button_Add}" Margin="0,20,0,0" Height="40" Click="AddButton_Click" IsDefault="True"/>
                    <Button Content="{DynamicResource Button_Cancel}" Margin="0,10,0,0" Height="40" Click="CancelButton_Click" IsCancel="True" Background="#D32F2F"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>